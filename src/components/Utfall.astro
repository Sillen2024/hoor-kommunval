---
import koladaData from "../data/kolada.json";
import partierData from "../data/partier.json";
import { TEMA_NYCKELTAL } from "../lib/tema-karta";

// Kolada etapp 3 (KOLADA_PLAN.md §6): utfallet bredvid löftena. Komponenten
// renderar ingenting för teman utan nyckeltal i TEMA_NYCKELTAL — frånvaron är
// medveten, inte en lucka.
//
// SPÄRR (etapp 3.3): ingen formulering får antyda att ett enskilt parti
// orsakat ett utfall — styret är ett minoritetsstyre och budgetarna har
// avgjorts i fullmäktige. Noten sist i komponenten renderas alltid.
//
// Spannet är valåret 2022 → senaste fastställda året, inte 2018 →: metoden för
// nettokostnadsavvikelse lades om 2019, och "under mandatperioden" är dessutom
// det enda tidsspann som hör ihop med löftena från valet 2022. Den längre
// serien finns på /nyckeltal/.

interface Props {
  tema: string;
  rubrik?: string;
  // När flera Utfall-block står direkt efter varandra (partisidorna) visas
  // introt bara på det första och spärrnoten bara på det sista.
  visaIntro?: boolean;
  visaNot?: boolean;
}
const { tema, rubrik = "Hur har det gått hittills?", visaIntro = true, visaNot = true } = Astro.props;

const matt = TEMA_NYCKELTAL[tema] ?? null;

const HÖÖR = koladaData.hoor;
const skane = koladaData.skane;
const VALAR = 2022;

type Serie = Record<string, Record<string, number>>;
const kpi = (id: string) => {
  const n = koladaData.nyckeltal.find((x) => x.kpi_id === id);
  if (!n) throw new Error(`Nyckeltal ${id} saknas i kolada.json — kör scripts/hamta-kolada.mjs`);
  return n;
};
const varde = (id: string, kod: string, ar: number): number | null =>
  (kpi(id).varden as unknown as Serie)[kod]?.[String(ar)] ?? null;

// Huvudår: senaste året som inte är preliminärt — samma logik som /nyckeltal/.
const preliminaraAr = [
  ...new Set(koladaData.nyckeltal.map((n) => n.preliminar_fran_ar).filter((a): a is number => a !== null)),
];
const huvudar =
  preliminaraAr.length > 0 ? Math.min(...preliminaraAr) - 1 : koladaData.ar[koladaData.ar.length - 1];

// Egen bearbetning (KOLADA_PLAN.md §2): snittet får inte anges med Kolada som
// källa och bär det streckade märket under tabellen.
const snitt = (id: string, ar: number): number | null => {
  const v = skane.map((k) => varde(id, k, ar)).filter((x): x is number => x !== null);
  return v.length === 0 ? null : v.reduce((s, x) => s + x, 0) / v.length;
};

// Klartext i figuren: Koladas måttnamn är förvaltningsspråk och minustecken
// läses lätt som belopp ("−16,9" togs för miljoner vid läsgranskningen
// 2026-08-29). Varje mått får därför en vardagsetikett, och värdena skrivs
// i ord — "19,2 % mindre än väntat" — i stället för med tecken. Exakta
// råvärden med tecken ligger kvar i tabellen under figuren.
const KLARTEXT: Record<string, { etikett: string; typ: "avvikelse" | "niva"; ord?: string }> = {
  N11024: { etikett: "Förskolans kostnad, mot väntad nivå", typ: "avvikelse" },
  N11102: { etikett: "Barn per anställd i förskolan", typ: "niva", ord: "barn" },
  N15001: { etikett: "Grundskolans kostnad, mot väntad nivå", typ: "avvikelse" },
  N15033: { etikett: "Elever per lärare i grundskolan", typ: "niva", ord: "elever" },
  N15507: { etikett: "Meritvärde i årskurs 9", typ: "niva", ord: "poäng" },
  N15428: { etikett: "Behöriga till gymnasiets yrkesprogram", typ: "niva", ord: "%" },
  N20900: { etikett: "Äldreomsorgens kostnad, mot väntad nivå", typ: "avvikelse" },
  U23401: { etikett: "Väntetid till särskilt boende", typ: "niva", ord: "dagar" },
  N30001: { etikett: "Individ- och familjeomsorgen, mot väntad nivå", typ: "avvikelse" },
  N00901: { etikett: "Kommunalskatten", typ: "niva", ord: "kr/hundralapp" },
  N03001: { etikett: "Kommunens överskott, andel av intäkterna", typ: "niva", ord: "%" },
  N03106: { etikett: "Soliditet (långsiktig betalningsförmåga)", typ: "niva", ord: "%" },
  N00097: { etikett: "Hela verksamhetens kostnad, mot väntad nivå", typ: "avvikelse" },
};

const rader = (matt ?? []).map((m) => {
  const n = kpi(m.id);
  return {
    id: m.id,
    titel: n.titel,
    enhet: n.enhet,
    klartext: KLARTEXT[m.id] ?? { etikett: `${n.titel} (${n.enhet})`, typ: "niva" as const },
    dec: m.dec,
    valar: varde(m.id, HÖÖR, VALAR),
    huvudar: varde(m.id, HÖÖR, huvudar),
    skaneSnitt: snitt(m.id, huvudar),
  };
});

// "19,2 % mindre än väntat" respektive "5,6 barn". Kortformen utelämnar
// "än väntat" — den används där sammanhanget redan är satt av huvudvärdet.
const iOrd = (r: (typeof rader)[number], v: number | null, kort = false) => {
  if (v === null) return "–";
  if (r.klartext.typ === "avvikelse") {
    if (v === 0) return "som väntat";
    return `${sv(Math.abs(v), r.dec)} % ${v < 0 ? "mindre" : "mer"}${kort ? "" : " än väntat"}`;
  }
  return `${sv(v, r.dec)}${r.klartext.ord ? ` ${r.klartext.ord}` : ""}`;
};

const sv = (v: number | null, d: number) =>
  v === null ? "–" : v.toLocaleString("sv-SE", { minimumFractionDigits: d, maximumFractionDigits: d });

// Hantelfiguren: varje mått får en egen skala som spänner över radens tre
// värden med luft i kanterna — måtten har olika enheter och kan inte dela
// axel. Figuren är aria-hidden dekoration; siffrorna står i klartext i
// samma rad och i tabellen under.
const lage = (r: (typeof rader)[number]) => {
  const v = [r.valar, r.huvudar, r.skaneSnitt].filter((x): x is number => x !== null);
  if (v.length < 2) return null;
  const lo = Math.min(...v);
  const hi = Math.max(...v);
  const marg = (hi - lo || Math.abs(hi) || 1) * 0.12;
  const pos = (x: number) => ((x - lo + marg) / (hi - lo + 2 * marg)) * 100;
  return {
    valar: r.valar === null ? null : pos(r.valar),
    huvudar: r.huvudar === null ? null : pos(r.huvudar),
    snitt: r.skaneSnitt === null ? null : pos(r.skaneSnitt),
  };
};

// Mandaten läses ur partier.json så att noten inte kan glida ifrån datan.
const styreMandat = partierData.partier
  .filter((p) => p.block === "styre")
  .reduce((s, p) => s + p.mandat_2022, 0);
const totalMandat = partierData.partier.reduce((s, p) => s + p.mandat_2022, 0);

const kallaUrl = `https://api.kolada.se/v3/data/kpi/${(matt ?? []).map((m) => m.id).join(",")}/municipality/${HÖÖR}/year/${VALAR},${huvudar}`;
---

{matt && (
  <div class="utfall">
    <h3>{rubrik}</h3>
    {visaIntro && (
      <p>
        Löften kan läsas mot utfall. Varje rad visar var Höör låg vid förra valet ({VALAR}), var Höör
        ligger {huvudar} — det senaste året med fastställda värden — och snittet för Skånes kommuner.
        "Mindre än väntat" betyder att verksamheten kostade mindre än vad en kommun med Höörs
        förutsättningar väntas lägga; måttet heter{" "}
        <a href="/ordlista/#nettokostnadsavvikelse">nettokostnadsavvikelse</a> och förklaras i ordlistan.
      </p>
    )}
    <p class="utfall__legend">
      <span class="utfall__legendpost"><span class="utfall__prick utfall__prick--valar" aria-hidden="true" />Höör {VALAR}</span>
      <span class="utfall__legendpost"><span class="utfall__prick utfall__prick--nu" aria-hidden="true" />Höör {huvudar}</span>
      <span class="utfall__legendpost"><span class="utfall__streck" aria-hidden="true" />Snitt Skåne {huvudar}</span>
    </p>
    <ol class="utfall__rader">
      {rader.map((r) => {
        const p = lage(r);
        return (
          <li class="utfall__rad">
            <span class="utfall__namn">{r.klartext.etikett}</span>
            {p && (
              <span class="utfall__spar" aria-hidden="true">
                {p.valar !== null && p.huvudar !== null && (
                  <span
                    class="utfall__lina"
                    style={`left:${Math.min(p.valar, p.huvudar)}%;width:${Math.abs(p.huvudar - p.valar)}%`}
                  />
                )}
                {p.snitt !== null && <span class="utfall__snitt" style={`left:${p.snitt}%`} />}
                {p.valar !== null && <span class="utfall__prick utfall__prick--valar" style={`left:${p.valar}%`} />}
                {p.huvudar !== null && <span class="utfall__prick utfall__prick--nu" style={`left:${p.huvudar}%`} />}
              </span>
            )}
            <span class="utfall__siffror"><strong>{iOrd(r, r.huvudar)}</strong></span>
            <span class="utfall__underrad">
              2022: {iOrd(r, r.valar, true)} · snittet i Skåne: {iOrd(r, r.skaneSnitt, true)}
            </span>
          </li>
        );
      })}
    </ol>
    <details class="utfall__tabell">
      <summary>Samma siffror som tabell</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Mått</th>
            <th scope="col">Höör {VALAR}</th>
            <th scope="col">Höör {huvudar}</th>
            <th scope="col">Snitt Skåne {huvudar}</th>
          </tr>
        </thead>
        <tbody>
          {rader.map((r) => (
            <tr>
              <th scope="row">{r.titel} ({r.enhet})</th>
              <td>{sv(r.valar, r.dec)}</td>
              <td><strong>{sv(r.huvudar, r.dec)}</strong></td>
              <td>{sv(r.skaneSnitt, r.dec)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </details>
    <a class="source-link" href={kallaUrl} target="_blank" rel="noopener noreferrer">
      Källa: Kolada — Höörs värden {VALAR} och {huvudar}
    </a>
    <span class="derived-note">Skånesnittet är uträknat här ur Koladas råvärden</span>
    {visaNot && (
      <p class="updated">
        Siffrorna visar hur det blev — inte vilket parti som orsakat det. Styret har {styreMandat} av{" "}
        {totalMandat} mandat, och besluten har fattats av hela fullmäktige. Hur varje parti röstade syns
        under <a href="/arenden/">Ärenden</a>, och fler jämförelser under <a href="/nyckeltal/">Nyckeltal</a>.
      </p>
    )}
  </div>
)}

<style>
  .utfall {
    margin-top: 1.8rem;
  }

  .utfall table {
    font-size: 0.92rem;
  }

  .utfall__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    margin: 0.6rem 0 0.2rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
  }

  .utfall__legendpost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .utfall__rader {
    list-style: none;
    margin: 0.4rem 0 0.5rem;
    padding: 0;
  }

  .utfall__rad {
    display: grid;
    grid-template-columns: 13rem 1fr 12rem;
    align-items: center;
    gap: 0.15rem 0.6rem;
    padding: 0.34rem 0;
    font-size: 0.92rem;
  }

  .utfall__namn {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .utfall__enhet {
    color: var(--color-muted);
  }

  .utfall__siffror {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  /* Klartextraden under varje mått: jämförelsepunkterna i ord. */
  .utfall__underrad {
    grid-column: 1 / -1;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .utfall__spar {
    position: relative;
    display: block;
    height: 1.15rem;
    background: #f4f4f4;
    border-radius: 2px;
  }

  .utfall__lina {
    position: absolute;
    top: calc(50% - 1px);
    height: 2px;
    background: #c2cfd8;
  }

  .utfall__snitt {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    margin-left: -1px;
    background: #767676;
  }

  .utfall__prick {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    box-sizing: border-box;
  }

  .utfall__prick--valar { background: #9bb3c4; }
  .utfall__prick--nu { background: var(--color-accent); }

  /* Legenden återanvänder prick/streck utan absolut positionering. */
  .utfall__legend .utfall__prick,
  .utfall__legend .utfall__streck {
    position: static;
    margin: 0;
    flex: none;
  }

  .utfall__streck {
    display: inline-block;
    width: 2px;
    height: 0.9rem;
    background: #767676;
  }

  .utfall__tabell {
    margin: 0.3rem 0 0.5rem;
    font-size: 0.9rem;
  }

  .utfall__tabell summary {
    cursor: pointer;
    color: var(--color-muted);
  }

  @media (max-width: 46rem) {
    .utfall__rad {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      padding: 0.4rem 0;
    }
  }
</style>
