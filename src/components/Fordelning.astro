---
// En delad liggande stapel för en fördelning (ja/nej/avstod i en votering,
// eller ett partis samlade röstprofil). Samma doktrin som övriga diagram:
// ingen JavaScript, stapeln är aria-hidden dekoration och talen står alltid
// i klartext intill — segmenten bär sin siffra bara när den får plats.
//
// Färgerna kommer från partifarger.ts (FARG_JA/NEJ/AVSTOD) via anroparen.

interface Del {
  etikett: string;
  antal: number;
  farg: string;
}

interface Props {
  delar: Del[];
}

const { delar } = Astro.props;
const synliga = delar.filter((d) => d.antal > 0);
const total = synliga.reduce((s, d) => s + d.antal, 0);
// Siffran ritas i segmentet först när det är brett nog att rymma den med
// luft på båda sidor — annars klipps den eller sväller ut ur färgen.
const MINSTA_ANDEL_MED_SIFFRA = 0.09;
---

{total > 0 && (
  <span class="frd" aria-hidden="true">
    {synliga.map((d) => (
      <span
        class="frd__del"
        style={`flex-grow:${d.antal};background:${d.farg}`}
        title={`${d.antal} ${d.etikett}`}
      >
        {d.antal / total >= MINSTA_ANDEL_MED_SIFFRA && <span class="frd__tal">{d.antal}</span>}
      </span>
    ))}
  </span>
)}

<style>
  .frd {
    display: flex;
    gap: 2px;
    height: 1.15rem;
    margin: 0.35rem 0 0.6rem;
    max-width: 38rem;
  }

  .frd__del {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    min-width: 3px;
  }

  .frd__tal {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
  }
</style>
