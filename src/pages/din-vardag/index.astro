---
import Layout from "../../layouts/Layout.astro";
import partierData from "../../data/partier.json";
import { TEMA_KARTA } from "../../lib/tema-karta";

type Stance = { partiId: string; partiNamn: string; block: string; radRubrik: string; standpunkt: string; kalla_url: string; kalla_titel?: string };

const temaMap = new Map<string, Stance[]>();
for (const party of partierData.partier) {
  for (const stance of party.manifest_2026) {
    const tema = TEMA_KARTA[stance.politikomrade] ?? stance.politikomrade;
    if (!temaMap.has(tema)) temaMap.set(tema, []);
    temaMap.get(tema)!.push({
      partiId: party.id,
      partiNamn: party.namn,
      block: party.block,
      radRubrik: stance.politikomrade,
      standpunkt: stance.standpunkt,
      kalla_url: stance.kalla_url,
      kalla_titel: "kalla_titel" in stance ? (stance as { kalla_titel?: string }).kalla_titel : undefined,
    });
  }
}

const SITUATIONER = [
  {
    id: "foralder",
    namn: "Jag är förälder",
    beskrivning: "Skola, förskola och elevhälsa.",
    teman: ["Skola och barnomsorg"],
  },
  {
    id: "pensionar",
    namn: "Jag är pensionär",
    beskrivning: "Äldreomsorg, vård och kollektivtrafik.",
    teman: ["Vård och omsorg", "Trafik, infrastruktur och bostäder"],
  },
  {
    id: "foretagare",
    namn: "Jag är företagare",
    beskrivning: "Näringsliv, handläggning och ekonomi.",
    teman: ["Näringsliv och ekonomi"],
  },
  {
    id: "landsbygd",
    namn: "Jag bor utanför centralorten",
    beskrivning: "Landsbygd, klimat, vägar och kollektivtrafik.",
    teman: ["Miljö, klimat och landsbygd", "Trafik, infrastruktur och bostäder"],
  },
];

// Samma förbehåll som på /jamforelse/: skilj lokala löften från nationella
// ståndpunkter och sociala medier-källor. Renderas alltid.
const mParti = partierData.partier.find((p) => p.id === "m");
const ersattaPartier = partierData.partier.filter((p) => p.manifest_status === "ersatt").map((p) => p.namn);
const mFranWebbplats =
  mParti?.manifest_2026.filter((s) => s.kalla_url.includes("moderatweb")).length ?? 0;
const ersattaText = new Intl.ListFormat("sv", { style: "long", type: "conjunction" }).format(ersattaPartier);

const situationerMedInnehall = SITUATIONER.map((s) => {
  const stances = s.teman.flatMap((tema) => temaMap.get(tema) ?? []);
  const styre = stances.filter((st) => st.block === "styre");
  const opposition = stances.filter((st) => st.block === "opposition");
  return { ...s, styre, opposition };
});
---

<Layout
  title="Din vardag"
  description="Välj din situation — förälder, pensionär, företagare eller landsbygdsbo — och se vad styret och oppositionen lovar just dig, med källa."
  image="/og-din-vardag-v1.png"
>
  <h1>Vad lovar partierna just dig?</h1>
  <p class="lead">
    I stället för att leta dig fram parti för parti — välj den situation som stämmer bäst in på dig. Du får en
    skräddarsydd vy av vad styret och oppositionen lovar inom det som spelar mest roll för dig, med källa på
    varje ståndpunkt.
  </p>

  <div class="banner">
    {ersattaPartier.length > 0 && (
      <Fragment>
        För {ersattaText} visar korten <strong>nationella</strong> ståndpunkter — partierna saknar lokalt
        valmanifest för Höör.
      </Fragment>
    )}
    {mParti?.manifest_status === "hittat" && mFranWebbplats > 0 && (
      <Fragment>
        {" "}Moderaterna lade ut sitt program i slutet av augusti. {mFranWebbplats} av deras punkter kommer
        därifrån, resten från partiets egna Facebook-inlägg —{" "}
        <a href="/partier/m/">så kontrollerade vi det</a>.
      </Fragment>
    )}
    {mParti?.manifest_status === "sociala_medier" && (
      <Fragment>
        {" "}Moderaternas punkter bygger på partiets egna Facebook-inlägg, inte ett publicerat program —{" "}
        <a href="/partier/m/">så kontrollerade vi det</a>.
      </Fragment>
    )}
  </div>

  <div class="situation-picker" id="situation-picker" role="group" aria-label="Välj din situation">
    {situationerMedInnehall.map((s, i) => (
      <button type="button" class="situation-picker__btn" data-situation={s.id} aria-pressed={i === 0 ? "true" : "false"}>
        <span class="situation-picker__namn">{s.namn}</span>
        <span class="situation-picker__beskrivning">{s.beskrivning}</span>
      </button>
    ))}
  </div>

  {situationerMedInnehall.map((s, i) => (
    <section class="situation-view" data-situation-view={s.id}>
      <h2>{s.namn}: vad lovar blocken?</h2>
      <div class="compare-grid">
        <div class="compare-col compare-col--styre">
          <h3><span class="badge badge--styre">Styre</span></h3>
          {s.styre.length === 0 ? (
            <p class="no-data">Inget styrande parti har publicerat en ståndpunkt inom detta område.</p>
          ) : (
            <div class="stance-grid">
              {s.styre.map((st) => (
                <div class={`stance-card ${st.block}`}>
                  <div class="stance-card__header"><a href={`/partier/${st.partiId}/`}>{st.partiNamn}</a></div>
                  <p class="stance-card__label">{st.radRubrik}</p>
                  <p>{st.standpunkt}</p>
                  <a class="source-link" href={st.kalla_url} target="_blank" rel="noopener noreferrer">{st.kalla_titel ?? "Källa →"}</a>
                </div>
              ))}
            </div>
          )}
        </div>
        <div class="compare-col compare-col--opposition">
          <h3><span class="badge badge--opposition">Opposition</span></h3>
          {s.opposition.length === 0 ? (
            <p class="no-data">Inget oppositionsparti har publicerat en ståndpunkt inom detta område.</p>
          ) : (
            <div class="stance-grid">
              {s.opposition.map((st) => (
                <div class={`stance-card ${st.block}`}>
                  <div class="stance-card__header"><a href={`/partier/${st.partiId}/`}>{st.partiNamn}</a></div>
                  <p class="stance-card__label">{st.radRubrik}</p>
                  <p>{st.standpunkt}</p>
                  <a class="source-link" href={st.kalla_url} target="_blank" rel="noopener noreferrer">{st.kalla_titel ?? "Källa →"}</a>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <script is:inline>
    // Utan JavaScript visas alla situationer (och knapparna gör inget). Med JavaScript
    // döljs alla utom den första här, synkront under parsningen, så inget hinner blinka till.
    document.querySelectorAll(".situation-view").forEach((view, i) => {
      if (i > 0) view.style.display = "none";
    });
  </script>

  <p>
    Ingen situation som passar? Se hela <a href="/jamforelse/">jämförelsevyn</a> uppdelad på alla politikområden,
    eller testa <a href="/#valkompass">valkompassen</a> på startsidan.
  </p>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("#situation-picker .situation-picker__btn");
    const views = document.querySelectorAll<HTMLElement>(".situation-view");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const situation = btn.dataset.situation;
        buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        views.forEach((view) => {
          const show = view.dataset.situationView === situation;
          view.style.display = show ? "" : "none";
          if (show) {
            view.classList.remove("fade-in");
            void view.offsetWidth;
            view.classList.add("fade-in");
          }
        });
      });
    });
  </script>

  <p class="updated">Senast uppdaterad: {partierData.senast_uppdaterad}</p>
</Layout>
