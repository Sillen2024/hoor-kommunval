---
import Layout from "../../layouts/Layout.astro";
import Jamforelse from "../../components/Jamforelse.astro";
import koladaData from "../../data/kolada.json";
import budgetData from "../../data/budget.json";
import oppositionsbudgetar from "../../data/oppositionsbudgetar.json";
import partierData from "../../data/partier.json";
import opinionData from "../../data/opinion.json";

// Höör i jämförelse, byggd helt på Koladas råvärden.
//
// LICENS (KOLADA_PLAN.md §2): råvärdena får märkas "Källa: Kolada". Snitt,
// placeringar och differenser räknas här vid byggtid och märks som egen
// bearbetning. Inget av det uträknade får tillskrivas Kolada.
//
// Ingenting på sidan är skrivet som en siffra i löptext. Varje tal läses ur
// kolada.json, så att en revidering hos Kolada slår igenom överallt samtidigt
// i stället för att lämna kvar en gammal siffra i en mening.

type Serie = Record<string, Record<string, number>>;

const HÖÖR = koladaData.hoor;
const kommunnamn = koladaData.kommuner as Record<string, string>;
const skane = koladaData.skane;
const grannar = koladaData.grannar;
const koladaAr = koladaData.ar;

const kpi = (id: string) => {
  const n = koladaData.nyckeltal.find((x) => x.kpi_id === id);
  if (!n) throw new Error(`Nyckeltal ${id} saknas i kolada.json — kör scripts/hamta-kolada.mjs`);
  return n;
};

const varde = (id: string, kod: string, ar: number): number | null =>
  (kpi(id).varden as unknown as Serie)[kod]?.[String(ar)] ?? null;

// Huvudår: senaste året som inte är preliminärt. Samma logik som på
// budgetsidan — nettokostnadsavvikelserna fastställs 2026-09-30, efter
// valdagen, så det senaste året är preliminärt hela valrörelsen igenom.
const preliminaraAr = [
  ...new Set(koladaData.nyckeltal.map((n) => n.preliminar_fran_ar).filter((a): a is number => a !== null)),
];
const senasteAr = koladaAr[koladaAr.length - 1];
const huvudar = preliminaraAr.length > 0 ? Math.min(...preliminaraAr) - 1 : senasteAr;
const arPreliminart = (id: string, ar: number) => {
  const p = kpi(id).preliminar_fran_ar;
  return p !== null && ar >= p;
};

const grupp = (nyckel: string) => {
  const g = koladaData.grupper.find((x) => x.nyckel === nyckel);
  if (!g) throw new Error(`Jämförelsegruppen ${nyckel} saknas i kolada.json`);
  return g;
};
const gruppFor = (id: string) => grupp(kpi(id).grupp);

// ——— Egna bearbetningar ————————————————————————————————————————————————
//
// Alla fyra funktionerna nedan producerar tal som INTE får anges med Kolada
// som källa. De hålls samlade här så att gränsen är lätt att se i koden.

const snitt = (id: string, koder: string[], ar: number): { varde: number | null; antal: number } => {
  const v = koder.map((k) => varde(id, k, ar)).filter((x): x is number => x !== null);
  return { varde: v.length === 0 ? null : v.reduce((s, x) => s + x, 0) / v.length, antal: v.length };
};

// Placering räknad från lägsta värdet. Riktningen står utskriven i texten
// varje gång — "plats 3" utan riktning är meningslöst för ett tal som kan
// vara både positivt och negativt och där lågt varken är bra eller dåligt.
const placering = (id: string, koder: string[], ar: number) => {
  const par = koder
    .map((k) => ({ kod: k, v: varde(id, k, ar) }))
    .filter((p): p is { kod: string; v: number } => p.v !== null)
    .sort((a, b) => a.v - b.v);
  const i = par.findIndex((p) => p.kod === HÖÖR);
  return i === -1 ? null : { plats: i + 1, av: par.length };
};

const rader = (id: string, koder: string[], ar: number, medSnitt = false, snittEtikett = "Snitt") => {
  const lista = koder
    .map((k) => ({
      namn: kommunnamn[k] ?? k,
      varde: varde(id, k, ar),
      markerad: k === HÖÖR,
      preliminar: arPreliminart(id, ar) && varde(id, k, ar) !== null,
    }))
    .sort((a, b) => (a.varde ?? Infinity) - (b.varde ?? Infinity));
  if (!medSnitt) return lista;
  const s = snitt(id, koder, ar);
  return [...lista, { namn: snittEtikett, varde: s.varde, harledd: true }];
};

// ——— Verksamheterna ————————————————————————————————————————————————————
//
// Samma sju som nämndramarna på budgetsidan avser, plus totalen. LSS ingår
// inte i totalen (N00097 är "exkl. LSS"), så den raden kan inte summeras ihop
// med de övriga — den står med för att LSS är en av socialnämndens tyngsta
// verksamheter och skulle saknas helt annars.
const verksamheter = [
  { namn: "Förskola", procent: "N11024", mnkr: "N11038", iTotal: true },
  { namn: "Fritidshem", procent: "N13020", mnkr: "N13032", iTotal: true },
  { namn: "Grundskola", procent: "N15001", mnkr: "N15045", iTotal: true },
  { namn: "Gymnasieskola", procent: "N17001", mnkr: "N17030", iTotal: true },
  { namn: "Äldreomsorg", procent: "N20900", mnkr: "N20029", iTotal: true },
  { namn: "Individ- och familjeomsorg", procent: "N30001", mnkr: "N30026", iTotal: true },
  { namn: "LSS", procent: "N28018", mnkr: "N28021", iTotal: false },
];

const verksamhetsrader = verksamheter.map((v) => {
  const g = gruppFor(v.procent);
  return {
    ...v,
    hoor: varde(v.procent, HÖÖR, huvudar),
    hoorMnkr: varde(v.mnkr, HÖÖR, huvudar),
    skaneSnitt: snitt(v.procent, skane, huvudar).varde,
    skanePlats: placering(v.procent, skane, huvudar),
    grannSnitt: snitt(v.procent, grannar, huvudar).varde,
    gruppNamn: g.etikett,
    gruppSnitt: snitt(v.procent, g.medlemmar, huvudar).varde,
    gruppPlats: placering(v.procent, [HÖÖR, ...g.medlemmar], huvudar),
  };
});

// Sorterad så att den största avvikelsen nedåt hamnar först. Ordningen är en
// egen bearbetning, men den ändrar inga siffror.
const verksamhetsraderSorterad = [...verksamhetsrader].sort(
  (a, b) => (a.hoor ?? Infinity) - (b.hoor ?? Infinity),
);

// ——— Övriga nyckeltal ——————————————————————————————————————————————————
//
// Här är riktningen inte neutral på samma sätt: ett högre meritvärde är
// entydigt bättre, en längre väntetid entydigt sämre. Sidan skriver ändå inte
// ut "bra"/"dåligt", bara placeringen och riktningen den räknats i.
// decimaler sätts per nyckeltal: skattesatsen är 21,75 och blir fel som 21,8,
// medan en kostnad per elev inte ska ha decimaler alls.
const ovriga = [
  { id: "N00901", decimaler: 2 },
  { id: "N03106", decimaler: 1 },
  { id: "N03001", decimaler: 1 },
  { id: "N15507", decimaler: 1 },
  { id: "N15428", decimaler: 1 },
  { id: "N15027", decimaler: 0 },
  { id: "N15033", decimaler: 1 },
  { id: "N11008", decimaler: 0 },
  { id: "N11102", decimaler: 1 },
  { id: "U23401", decimaler: 0 },
];

// Varje övrigt nyckeltal redovisas för sitt eget senaste år med värde för
// Höör. Att tvinga in dem i huvudåret skulle tömma tabellen på rader: t.ex.
// meritvärde och väntetid har olika publiceringstakt.
const ovrigaRader = ovriga.map((o) => {
  const n = kpi(o.id);
  const ar = [...koladaAr].reverse().find((a) => varde(o.id, HÖÖR, a) !== null) ?? huvudar;
  return {
    ...o,
    titel: n.titel,
    enhet: n.enhet,
    ar,
    preliminar: arPreliminart(o.id, ar),
    hoor: varde(o.id, HÖÖR, ar),
    skaneSnitt: snitt(o.id, skane, ar).varde,
    skaneAntal: snitt(o.id, skane, ar).antal,
    plats: placering(o.id, skane, ar),
  };
});

// ——— Enskilda fynd, uträknade ur serien ————————————————————————————————

// Lägsta kommunen, och lägsta som inte är Höör. Formuleringarna i texten
// växlar på hoorLagst i stället för att slå fast en placering: en revidering
// hos Kolada får inte lämna kvar "lägst i Skåne" i en mening där det slutat
// stämma.
const lagsta = (id: string, koder: string[], ar: number) => {
  const sorterad = koder
    .map((k) => ({ kod: k, v: varde(id, k, ar) }))
    .filter((p): p is { kod: string; v: number } => p.v !== null)
    .sort((a, b) => a.v - b.v);
  return {
    sorterad,
    hoorLagst: sorterad[0]?.kod === HÖÖR,
    lagstUtomHoor: sorterad.find((p) => p.kod !== HÖÖR)!,
  };
};

// Totalen (N00097) är ett netto. Skillnaden mellan den och verksamheterna är
// hela poängen med avsnittet, så summan och de två tyngsta posterna räknas
// fram i stället för att skrivas ut — annars står fel verksamhetsnamn kvar i
// meningen nästa gång Kolada reviderar.
const iTotalen = verksamhetsrader.filter(
  (v): v is typeof v & { hoorMnkr: number } => v.iTotal && v.hoorMnkr !== null,
);
const nettoSumma = iTotalen.reduce((s, v) => s + v.hoorMnkr, 0);
const storstUpp = [...iTotalen].sort((a, b) => b.hoorMnkr - a.hoorMnkr)[0];
const storstNed = [...iTotalen].sort((a, b) => a.hoorMnkr - b.hoorMnkr)[0];

const totalHoor = varde("N00097", HÖÖR, huvudar);
const totalPlats = placering("N00097", skane, huvudar);
const totalSkane = snitt("N00097", skane, huvudar);
const totalUnderNoll = skane
  .map((k) => varde("N00097", k, huvudar))
  .filter((v): v is number => v !== null && v < 0).length;

// ——— Förskolan ————————————————————————————————————————————————————————
//
// Två mått byggda på olika sätt: N11024 är relativ mot en strukturberäknad
// referenskostnad, N11008 är råa kronor per inskrivet barn utan någon modell
// emellan. Att båda pekar ut samma kommun är hela skälet att visa dem
// tillsammans — ett ensamt mått hade kunnat vara en artefakt i utjämningen.
const KOSTNAD_BARN = "N11008";
const BARN_ARSARB = "N11102";

const forskolaSkanePlats = placering("N11024", skane, huvudar);
const forskolaSkanePlatsPrel = placering("N11024", skane, senasteAr);
const forskolaHoor = varde("N11024", HÖÖR, huvudar);
const forskolaSkaneSnitt = snitt("N11024", skane, huvudar).varde;
const forskolaLagst = lagsta("N11024", skane, huvudar);

const kostnadHoor = varde(KOSTNAD_BARN, HÖÖR, huvudar);
const kostnadPlats = placering(KOSTNAD_BARN, skane, huvudar);
const kostnadSkane = snitt(KOSTNAD_BARN, skane, huvudar);
const kostnadLagst = lagsta(KOSTNAD_BARN, skane, huvudar);
// Avståndet till snittet, både i kronor och i procent. Procenten här är
// Höörs avvikelse från länssnittet — inte samma sak som N11024, som mäter mot
// en strukturberäknad referenskostnad. De två får inte förväxlas i texten.
const kostnadDiff =
  kostnadHoor !== null && kostnadSkane.varde !== null ? kostnadHoor - kostnadSkane.varde : null;
const kostnadDiffProc =
  kostnadHoor !== null && kostnadSkane.varde !== null
    ? ((kostnadHoor - kostnadSkane.varde) / kostnadSkane.varde) * 100
    : null;

const tathetHoor = varde(BARN_ARSARB, HÖÖR, huvudar);
const tathetPlats = placering(BARN_ARSARB, skane, huvudar);
const tathetSkane = snitt(BARN_ARSARB, skane, huvudar);

// Tidsserien. Bara år där avvikelsen finns — de tidigaste åren saknar värde
// för flera av nyckeltalen och skulle ge rader med enbart streck.
const forskolaSerie = koladaAr
  .map((a) => ({
    ar: a,
    procent: varde("N11024", HÖÖR, a),
    mnkr: varde("N11038", HÖÖR, a),
    krBarn: varde(KOSTNAD_BARN, HÖÖR, a),
    tathet: varde(BARN_ARSARB, HÖÖR, a),
    preliminar: arPreliminart("N11024", a),
  }))
  .filter((r) => r.procent !== null);
const forskolaForst = forskolaSerie[0];
const forskolaSenastFastst = forskolaSerie.filter((r) => !r.preliminar).at(-1)!;

// Den obrutna svansen: hur långt bakåt avvikelsen har vuxit varje år i följd.
// Räknas fram i stället för att skrivas ut, eftersom ett enda reviderat år kan
// bryta serien — då ska meningen ändra sig, inte bli fel. Serien spänner över
// metodbytet 2019, så en påstådd trend måste hålla sig innanför det.
const vaxandeFran = (() => {
  let i = forskolaSerie.length - 1;
  while (i > 0 && forskolaSerie[i].procent! < forskolaSerie[i - 1].procent!) i--;
  return forskolaSerie[i];
})();
const vaxandeAntalAr = forskolaSerie.at(-1)!.ar - vaxandeFran.ar;

// Hur många av de tre referenserna som ger samma bild. Räknas fram i stället
// för att påstås, eftersom den är hela poängen med att visa tre.
const forskolaUnderAllaSnitt = [
  snitt("N11024", skane, huvudar).varde,
  snitt("N11024", grannar, huvudar).varde,
  snitt("N11024", gruppFor("N11024").medlemmar, huvudar).varde,
].filter((s) => s !== null && (forskolaHoor ?? 0) < s).length;

// Överlapp mellan Skåne och grupperna: hur många av gruppmedlemmarna som
// också ligger i Skåne. Förklarar varför de tre referenserna skiljer sig.
const gruppKoder = [...new Set(koladaData.grupper.flatMap((g) => g.medlemmar))];
const gruppKoderISkane = gruppKoder.filter((k) => skane.includes(k));

const sv = (v: number | null, d = 1) =>
  v === null ? "–" : v.toLocaleString("sv-SE", { minimumFractionDigits: d, maximumFractionDigits: d });

// Kronor skrivs alltid ut med tusentalsavgränsare. 162 873 är läsbart,
// 162873 är det inte, och sidan handlar om att göra tal begripliga.
const kr = (v: number | null) => (v === null ? "–" : Math.round(v).toLocaleString("sv-SE"));

// Beloppen är signerade i Kolada: minus betyder under referenskostnaden. I
// löptext läser det bättre som "28,6 miljoner under" än "−28,6 miljoner", så
// texten sätter riktningen med ord och tar absolutbeloppet här.
const abs = (v: number | null, d = 1) => (v === null ? "–" : sv(Math.abs(v), d));
const riktning = (v: number | null) => (v === null ? "" : v < 0 ? "under" : "över");

const kallaUrl = (ids: string[], koder: string[], ar: number[]) =>
  `https://api.kolada.se/v3/data/kpi/${ids.join(",")}/municipality/${koder.join(",")}/year/${ar.join(",")}`;

// ——— Vägvalet: förskolan (Fabel-granskningen §3) ———————————————————————
// Alternativen och handlingen läses ur budget- och oppositionsdatan, så att
// blocket följer med om siffrorna ändras.
const partyName = (id: string) => partierData.partier.find((p) => p.id === id)?.namn ?? id.toUpperCase();
const bunHojningar = oppositionsbudgetar.forslag
  .filter((f) => f.namnd_diff_tkr && (f.namnd_diff_tkr as Record<string, number>)["Barn- och utbildningsnämnd"] > 0)
  .map((f) => ({
    ar: f.ar,
    parti: f.gemensamt_med ? `${partyName(f.parti_id)} och ${partyName(f.gemensamt_med)}` : partyName(f.parti_id),
    mnkr: (f.namnd_diff_tkr as Record<string, number>)["Barn- och utbildningsnämnd"] / 1000,
  }))
  .sort((a, b) => b.mnkr - a.mnkr);
const storstaBunHojning = bunHojningar[0];
const budgetVoteringar = budgetData.beslut.filter((b) => b.rostning);
const jaRoster = [...new Set(budgetVoteringar.map((b) => b.rostning!.ja))];
const nejRoster = [...new Set(budgetVoteringar.map((b) => b.rostning!.nej))];

// Opinionen i samma vägval: SkD:s Novus-mätning. Talen läses ur opinion.json,
// och jämförelsen med skola/äldrevård renderas bara om den stämmer i datan.
const novus = opinionData.undersokningar.find((u) => u.id === "skd-novus-2026-besparingar");
if (!novus) throw new Error("Novus-mätningen saknas i opinion.json");
const novusBarnomsorg = novus.hoor_bottenval_procent["Barnomsorg"];
const novusLikaLagt =
  novus.hoor_bottenval_procent["Skola"] === novusBarnomsorg &&
  novus.hoor_bottenval_procent["Äldrevård"] === novusBarnomsorg;
const novusManad = new Intl.DateTimeFormat("sv-SE", { month: "long", year: "numeric" }).format(
  new Date(novus.publicerad),
);
---

<Layout
  title="Nyckeltal — Höör i jämförelse"
  description={`Höörs kostnader och resultat jämförda med Skånes ${skane.length} kommuner, grannkommunerna och Koladas officiella "Liknande kommuner"-grupper. Alla siffror ur Koladas öppna API.`}
  image="/og-nyckeltal-v2.png"
>
  <article>
    <h1>Nyckeltal — Höör i jämförelse</h1>
    {forskolaLagst.hoorLagst && kostnadLagst.hoorLagst ? (
      <p class="lead">
        Höörs förskola kostar minst i hela Skåne — oavsett hur man räknar. Det är det tydligaste som syns
        när Höörs siffror ställs mot andra kommuners. Den här sidan visar var Höör lägger mer än
        jämförbara kommuner, var kommunen lägger mindre — och jämfört med vilka.
      </p>
    ) : (
      <p class="lead">
        Den här sidan ställer Höörs kostnader och resultat mot tre referenser samtidigt — Skånes kommuner,
        grannkommunerna och de mest jämförbara kommunerna — och visar när de säger samma sak och när de
        inte gör det.
      </p>
    )}

    <div class="not-box">
      <p>
        <strong>Det här är utfall, inte politik.</strong> Siffrorna visar vad verksamheten kostade och
        gav, inte vad något parti vill. De kommer ur <a href="#kallor">Kolada</a>, den nationella
        statistikdatabasen — inte ur kommunens eller något partis material — och Höör räknas på exakt
        samma sätt som alla andra kommuner.
      </p>
    </div>

    <p class="updated" id="legend">
      Läsanvisning: <strong>plats 1 = lägst värde i Skåne.</strong> Lågt är inte automatiskt bra eller
      dåligt. Snitt och placeringar är uträknade här ur Koladas råvärden och bär det streckade märket;
      varje enskild kommunsiffra är hämtad som den är och länkar till API-anropet.
    </p>

    <nav class="sidnav" aria-label="Innehåll på sidan">
      <ul>
        <li><a href="#forskola">Förskolan</a></li>
        <li><a href="#skane">Höör i Skåne</a></li>
        <li><a href="#grannar">Höör mot grannkommunerna</a></li>
        <li><a href="#liknande">Höör mot liknande kommuner</a></li>
        <li><a href="#ovriga">Övriga nyckeltal</a></li>
        <li><a href="#kallor">Var siffrorna kommer ifrån</a></li>
      </ul>
    </nav>

    <details class="not-box" id="tre-referenser">
      <summary>Vad jämförs Höör med — och vad är en referenskostnad?</summary>
      <p>
        <strong>Skånes {skane.length} kommuner</strong> är den geografiska referensen. Den är lätt att
        kontrollera och innehåller allt från Malmö till Perstorp — vilket också är dess svaghet: en kommun
        med {sv(varde("N00901", HÖÖR, senasteAr), 2)} i skattesats och några tusen invånare jämförs med en
        storstad.
      </p>
      <p>
        <strong>Grannkommunerna</strong> — {grannar.map((k) => kommunnamn[k]).join(", ")} — är den referens
        en Höörsbo faktiskt använder. Den är inte metodiskt matchad på någonting alls. Den står med ändå,
        därför att det är den jämförelse som görs i verkligheten och den bör då göras med rätt siffror.
      </p>
      <p>
        <strong>Koladas "Liknande kommuner"</strong> är den metodiskt starkaste. RKA matchar varje kommun
        mot sju andra utifrån struktur — befolkningsstorlek, andel barn eller äldre, skattekraft, geografi
        — och gör det <em>per verksamhet</em>. Därför är Höörs förskolegrupp inte samma kommuner som Höörs
        äldreomsorgsgrupp. Höör ingår inte i sina egna grupper, så ett gruppsnitt är ett snitt av sju andra
        kommuner. Av de {gruppKoder.length} kommuner som ingår i Höörs {koladaData.grupper.length} grupper
        ligger bara {gruppKoderISkane.length} i Skåne — den strukturella likheten följer inte länsgränsen.
      </p>
      <p>
        De tre svarar inte alltid lika. När de gör det är slutsatsen starkare än när bara en av dem gör
        det, och sidan visar därför alla tre i stället för att välja den som ger tydligast utslag.
      </p>
      <p>
        <strong>Referenskostnaden är inte en rekommendation.</strong> Den säger inte vad en kommun
        <em>borde</em> lägga. Den är vad verksamheten faktiskt kostar i riket i genomsnitt, omräknat till
        den enskilda kommunens struktur — åldersfördelning, tätortsgrad, socioekonomi, geografi. Måttet
        visar var Höör ligger i förhållande till hur andra kommuner gör — inte i förhållande till vad som
        vore rätt. Det betyder också att invändningen "men vi har ju en annan befolkning" redan är
        besvarad: att Höör har många äldre höjer referenskostnaden för äldreomsorgen, att kommunen har få
        små barn sänker den för förskolan. En avvikelse är det som återstår <em>efter</em> att strukturen
        räknats bort. Mer i <a href="/ordlista/#referenskostnad">ordlistan</a>.
      </p>
    </details>

    <section>
      <h2 id="forskola">Förskolan</h2>
      <p>
        Förskolan är det tydligaste utslaget i hela materialet, och det enda där två mått byggda på helt
        olika sätt pekar ut Höör som lägst i Skåne. Därför får den ett eget avsnitt.
      </p>

      <h3>Mått 1: avvikelse från den egna referenskostnaden</h3>
