---
import Layout from "../../layouts/Layout.astro";
import historiskaValData from "../../data/historiska_val.json";

const val = [...historiskaValData.val].sort((a, b) => b.ar - a.ar);
---

<Layout
  title="Historiska val"
  description="Riktiga, källbelagda valresultat (röster och röstandelar, inte bara mandat) för Höörs kommunfullmäktige, valet 2022 och tidigare val."
  image="/og-historiska-val-v1.png"
>
  <h1>Historiska val till Höörs kommunfullmäktige</h1>
  <p class="lead">
    Röster och röstandelar per parti — inte bara mandat — för valet till Höörs kommunfullmäktige. De flesta andra
    sidor på hoor.se och andra kommunala källor listar enbart mandatfördelningen; här redovisas i stället de
    faktiska röstsiffrorna, med källa, så att man kan se hur nära gränserna gick.
  </p>

  <div class="banner">{historiskaValData.metod_not}</div>

  {val.map((v) => (
    <section class="policy-block" id={`val-${v.ar}`}>
      <h2>{v.typ} {v.ar}</h2>
      <table>
        <tbody>
          <tr>
            <th>Valdag</th>
            <td>{v.valdag}</td>
          </tr>
          <tr>
            <th>Valdeltagande</th>
            <td>
              {v.valdeltagande}
              {v.valdeltagande_not && <div class="not-box">{v.valdeltagande_not}</div>}
            </td>
          </tr>
        </tbody>
      </table>

      <table>
        <thead>
          <tr>
            <th>Parti</th>
            <th>Röster</th>
            <th>Andel</th>
            <th>Mandat</th>
          </tr>
        </thead>
        <tbody>
          {v.resultat.map((r) => {
            const isStyre = "styre_partier" in v && (v as any).styre_partier?.includes(r.parti);
            return (
              <tr>
                <td>
                  {r.parti}
                  {isStyre && <> <span class="badge badge--styre">Styre</span></>}
                </td>
                <td>{r.roster.toLocaleString("sv-SE")}</td>
                <td>{r.andel}</td>
                <td>{r.mandat ?? <span class="no-data">Ej verifierat</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      {v.resultat_not && <div class="not-box">{v.resultat_not}</div>}
      {v.mandat_not && <div class="not-box">{v.mandat_not}</div>}
      {v.styre_efter_valet && <p><strong>Styre efter valet:</strong> {v.styre_efter_valet}</p>}

      <a class="source-link" href={v.kalla_url} target="_blank" rel="noopener noreferrer">{v.kalla_beskrivning}</a>
      {v.kalla_url_2 && (
        <p><a class="source-link" href={v.kalla_url_2} target="_blank" rel="noopener noreferrer">{v.kalla_url_2_beskrivning}</a></p>
      )}
    </section>
  ))}

  <p class="updated">Senast uppdaterad: {historiskaValData.senast_uppdaterad}. Fler detaljer om metoden: <a href="/om-urvalet/">Om urvalet</a>.</p>
</Layout>
