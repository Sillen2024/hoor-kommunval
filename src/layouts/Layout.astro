---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Fakta om Höörs kommunval 2026: vad styret har beslutat och vad partierna lovar.",
  image = "/og-image.png"
} = Astro.props;

// Huvudmenyn följer läsarens resa (Fabel-granskningen §6): åtta poster, ordnade
// från "vad ska jag rösta på" till fördjupning. Arkiv- och metodsidorna ligger
// i sidfotsmenyn nedan — de ska gå att hitta, inte stå i vägen.
const navItems = [
  { href: "/", label: "Start" },
  { href: "/din-vardag/", label: "Din vardag" },
  { href: "/partier/", label: "Partierna" },
  { href: "/jamforelse/", label: "Jämförelse" },
  { href: "/styret-vs-oppositionen/", label: "Styret vs oppositionen" },
  { href: "/budget/", label: "Budget" },
  { href: "/nyckeltal/", label: "Nyckeltal" },
  { href: "/arenden/", label: "Ärenden och motioner" },
];

const currentPath = Astro.url.pathname;

// Rättelselänk per sida (punkt 23). Sidans adress och rubrik fylls i vid
// byggtillfället, så att en felanmälan alltid pekar på rätt sida även när
// läsaren inte vet vad sidan heter. Ingen JavaScript inblandad.
const rattaAdress = "hej@ibland.nu";
const rattaAmne = `Rättelse: ${title}`;
const rattaBrodtext = [
  `Sida: ${Astro.url}`,
  "",
  "Vad står det nu:",
  "",
  "Vad borde det stå:",
  "",
  "Källa, om du har en:",
  "",
].join("\n");
const rattaMailto = `mailto:${rattaAdress}?subject=${encodeURIComponent(rattaAmne)}&body=${encodeURIComponent(rattaBrodtext)}`;
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{title} — Höörs kommunval 2026</title>
    <meta name="title" content={`${title} — Höörs kommunval 2026`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} — Höörs kommunval 2026`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} — Höörs kommunval 2026`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Links -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Höörs kommunval 2026",
        "url": "https://hoor-kommunval.ibland.nu",
        "description": "Fakta om Höörs kommunval 2026: vad styret har beslutat och vad partierna lovar."
      }
    </script>

    <!-- Analytics -->
    <script defer src="https://umami.ibland.nu/script.js" data-website-id="8ecedae6-4356-4d94-b9ce-ed99985647a3"></script>
  </head>
  <body>
    <a class="skip-link" href="#innehall">Hoppa till innehållet</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__title">
          <img src="/header-logo.png" alt="Höörs kommunval 2026" width="654" height="200" />
          <small>Fakta om styrets beslut och partiernas löften</small>
        </a>
        <nav class="site-nav" aria-label="Huvudmeny">
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="innehall">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        {/* Löptexten länkar inte det sidfotsmenyn strax under redan länkar
            (Om urvalet, Rätta en uppgift) — skärmläsare läser annars upp
            varje mål två gånger (Fabel-granskning 2, §2.4.3). */}
        <p>
          Den här sajten är en oberoende, ideell faktasammanställning inför kommunvalet i Höör 13 september 2026.
          Den drivs inte av något parti och värderar inte vad partierna säger — bara dokumenterade fakta med källa.
          Sajten är ett urval, inte en heltäckande genomgång — se Om urvalet för vad som är med och vad som medvetet uteslutits.
        </p>
        <p class="site-footer__ratta">
          <strong>Hittat ett fel på den här sidan?</strong>{" "}
          <a href={rattaMailto}>Rapportera det direkt</a> — sidans adress fylls i åt dig. Så prövas och redovisas
          rättelser: Rätta en uppgift.
        </p>
        <nav aria-label="Sidfotsmeny">
          <ul>
            <li><a href="/valkompass/">Valkompassen</a></li>
            <li><a href="/sa-rostar-du/">Så röstar du</a></li>
            <li><a href="/vad-bestammer-kommunen/">Vad bestämmer kommunen?</a></li>
            <li><a href="/historiska-val/">Historiska val</a></li>
            <li><a href="/om-urvalet/">Om urvalet / metod</a></li>
            <li><a href="/om-urvalet/#kallor">Källor</a></li>
            <li><a href="/ordlista/">Ordlista</a></li>
            <li><a href="/ratta/">Rätta en uppgift</a></li>
            <li><a href="/om/">Om sidan</a></li>
            <li><a href={`mailto:${rattaAdress}`}>{rattaAdress}</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
